<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lk.menara</groupId>
        <artifactId>GlobalTrade</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>globaltrade-ear</artifactId>
    <packaging>ear</packaging>
    <name>globaltrade-ear</name>

    <dependencies>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-core</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-auth</artifactId>
            <version>1.0</version>
            <type>jar</type> <!-- මෙතැන ejb වෙනුවට jar ලෙස වෙනස් කළ යුතුය -->
        </dependency>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-scm</artifactId>
            <version>1.0</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-logs</artifactId>
            <version>1.0</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-rest</artifactId>
            <version>1.0</version>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>lk.menara</groupId>
            <artifactId>globaltrade-web</artifactId>
            <version>1.0</version>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>globaltrade</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <version>10</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>

                        <ejbModule>
                            <groupId>lk.menara</groupId>
                            <artifactId>globaltrade-scm</artifactId>
                        </ejbModule>
                        <ejbModule>
                            <groupId>lk.menara</groupId>
                            <artifactId>globaltrade-logs</artifactId>
                        </ejbModule>
                        <webModule>
                            <groupId>lk.menara</groupId>
                            <artifactId>globaltrade-rest</artifactId>
                            <contextRoot>/globaltrade</contextRoot>
                        </webModule>
                        <webModule>
                            <groupId>lk.menara</groupId>
                            <artifactId>globaltrade-web</artifactId>
                            <contextRoot>/app</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>