<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="globaltradePU" transaction-type="JTA">
        <jta-data-source>jdbc/GlobalTrade</jta-data-source>
        <properties>
            <!-- Schema generation: create drops and recreates schema -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <!-- Use H2 for testing (lightweight in-memory database) -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <!-- Disable SQL logging for cleaner test output -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
